# Environment variables for ecu-sim

# ECU Simulator Control Port
SIM_CONTROL_PORT=8181

# ECU Simulator Gateway Port
SIM_GATEWAY_PORT=13400

# CDA Service Port
CDA_PORT=20002

# Kuksa Databroker port, as published on the host.
#
# The upstream default is 55555, but on Windows that port lies inside the
# WinNAT / Hyper-V reserved port exclusion ranges (the dynamic port range is
# 49152-65535), which makes Docker fail with:
#
#   Error response from daemon: ports are not available: exposing port
#   TCP 127.0.0.1:55555 -> ...: bind: An attempt was made to access a socket
#   in a way forbidden by its access permissions.
#
# Check the reserved ranges with:  netsh int ipv4 show excludedportrange protocol=tcp
# Pick any free port below 49152 to stay clear of them.
DATABROKER_PORT=25555
